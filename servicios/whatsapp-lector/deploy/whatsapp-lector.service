# systemd: dejar el lector andando y que arranque solo con el servidor.
#
#   sudo cp deploy/whatsapp-lector.service /etc/systemd/system/apicanta-whatsapp-lector.service
#   (editá User, WorkingDirectory y ExecStart si tus rutas son otras: `which node` dice dónde está Node)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now apicanta-whatsapp-lector
#   journalctl -u apicanta-whatsapp-lector -f        (los registros)
#
# Los datos (APP_URL, el token…) los lee el propio servicio del archivo .env de WorkingDirectory.

[Unit]
Description=Lector de WhatsApp de Apicanta (solo lectura)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lector
WorkingDirectory=/opt/apicanta-whatsapp-lector
ExecStart=/usr/bin/node src/index.js
Environment=NODE_ENV=production
Environment=TZ=America/Argentina/Buenos_Aires
# Todo lo que cree el servicio (la sesión de WhatsApp, sobre todo) queda sólo para su usuario.
UMask=0077
Restart=always
RestartSec=10
# Si se cae una y otra vez, la espera crece (de 10 segundos a 5 minutos) en vez de volver a entrar a WhatsApp cada 10
# segundos para siempre. Necesita systemd 254 o más; en uno anterior se ignora y queda RestartSec.
RestartSteps=5
RestartMaxDelaySec=300
# Al apagarlo, el servicio vacía los avisos y manda el último latido (el código le pone un tope de ~20 segundos). Si
# systemd lo mata antes, podría dejar a medio escribir las llaves de la sesión.
TimeoutStopSec=30
# Una sola copia: dos con la misma sesión de WhatsApp se pelean.
# El servicio sólo hace conexiones hacia afuera; no abre ningún puerto.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/apicanta-whatsapp-lector

[Install]
WantedBy=multi-user.target
