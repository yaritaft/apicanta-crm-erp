# Copiá este archivo a «.env» y completalo. El «.env» no se sube al repo.

# La dirección de Apicanta, sin barra al final. Tiene que ser https:// (http:// sólo se acepta para localhost,
# para probar en tu compu: por la red, el secreto y el código QR viajarían a la vista de cualquiera).
APP_URL=https://tu-apicanta.vercel.app

# El secreto compartido con la app. Es el MISMO valor que la variable
# WHATSAPP_LECTOR_TOKEN de Vercel. Inventalo largo (por ejemplo, con:
#   openssl rand -hex 32 ). Nunca lo escribas en el repo ni en un chat.
WHATSAPP_LECTOR_TOKEN=

# Qué grupos mirar: una expresión regular que se prueba contra el NOMBRE del
# grupo (sin distinguir mayúsculas). OBLIGATORIA: sin ella el lector no arranca
# (miraría los teléfonos de TODOS los grupos del número). Para mirarlos todos, a
# propósito: GRUPOS_REGEX=.*   Sin repeticiones dentro de repeticiones, como (.*a)+
# Los grupos de los talleres se llaman «Taller Online 08/10/26 #1», #2…
GRUPOS_REGEX=taller online

# --- Opcionales ---
# Dónde se guarda la sesión de WhatsApp.
# AUTH_DIR=./auth
# Cada cuántos segundos avisa que sigue vivo (la app avisa al equipo si pasan 15 minutos sin latido).
# LATIDO_CADA_SEG=120
# Cada cuántas horas vuelve a mandar la lista completa de cada grupo, por si se perdió un aviso. 0: nunca.
# FOTO_CADA_HORAS=6
# trace, debug, info, warn o error. Con debug o trace, Baileys cuenta mucho de más (aunque se tapan los números
# largos): no lo dejes prendido.
# LOG_LEVEL=info
# 1: además de mandar el código QR a la app, lo dibuja en la terminal (sólo para depurar;
# es lo mismo que correr con --qr-terminal).
# QR_EN_TERMINAL=
