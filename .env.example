# Sin estas dos variables la app guarda todo en el navegador y funciona igual.
# Con las dos, usa Supabase y se sincroniza entre dispositivos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Cobros en tiempo real ---
# Sin esto los webhooks no pueden escribir: la clave de servicio saltea RLS
# y por eso vive sólo en el servidor. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Un secreto largo inventado por vos. Va en la URL que se pega en cada
# pasarela: ?token=ESTE_VALOR. Sin él, el webhook rechaza todo.
PASARELAS_WEBHOOK_TOKEN=
# Firmas propias de cada pasarela (opcionales, suman una capa más).
STRIPE_WEBHOOK_SECRET=
HOTMART_HOTTOK=
# Lo usa el cron horario de Vercel, que repesca lo que algún webhook haya perdido.
CRON_SECRET=

# --- Pasarelas de cobro (opcionales) ---
# Sin estas claves la conciliación funciona igual: los cobros se importan
# pegando el CSV que exporta cada plataforma. Con ellas entran solos.

# Avisan al instante por webhook + se les puede preguntar
STRIPE_SECRET_KEY=sk_live_...
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=
WHOP_API_KEY=
DLOCAL_X_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# No avisan: los consulta el cron cada hora
MERCURY_API_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# La dirección TRC20 de la billetera Trust, tal cual (empieza con T)
TRUST_WALLET_ADDRESS=
# Opcional: sin clave, Tronscan limita las consultas
TRONSCAN_API_KEY=

# --- YouTube ---
# Los datos públicos de cada video (vistas, likes, comentarios, chat del vivo,
# espectadores minuto a minuto). Google Cloud → YouTube Data API v3 → Credenciales.
YOUTUBE_API_KEY=
# YouTube Analytics (opcional): retención, tiempo de reproducción, fuentes,
# países, edades. Cliente OAuth "Aplicación web" del mismo proyecto de Google,
# con la YouTube Analytics API activada y esta URL de redirección:
#   https://<tu-dominio>/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Conversions API ---
# Manda a Meta los registros al webinar (Lead), las agendas (Schedule) y las
# ventas (Purchase) desde el servidor. Sin estas dos, no manda nada.
META_PIXEL_ID=
# Events Manager → el píxel → Configuración → Conversions API → Generar token.
# Si falta, se usa META_SYSTEM_TOKEN.
META_CAPI_TOKEN=
# Opcional: el código de "Probar eventos" para verlos sin que cuenten.
META_CAPI_TEST=

# --- Registro de la landing del webinar (/api/webinar/registro) ---
# Opcional: los dominios que pueden mandar registros, separados por coma
# (https://hackearit.com,https://www.hackearit.com). Vacío: cualquiera.
REGISTRO_ORIGENES=

# --- Lector de WhatsApp (servicios/whatsapp-lector) ---
# El secreto compartido con el servicio que corre en el VPS y lee los grupos de
# los talleres: va en «Authorization: Bearer …» a /api/whatsapp/grupos y
# /api/whatsapp/latido. Sin él esas rutas contestan 503. Inventalo largo
# (openssl rand -hex 32) y poné el MISMO valor en el .env del servicio. Nunca
# lo escribas en el repo. Necesita SUPABASE_SERVICE_ROLE_KEY (arriba).
WHATSAPP_LECTOR_TOKEN=
# Sólo para probar en tu compu sin Supabase: dónde guardan las rutas lo que les
# manda el servicio simulado. Vacío: un archivo en la carpeta temporal.
WHATSAPP_ARCHIVO_LOCAL=

# --- Reportes semanales de los alumnos (Customer Success) ---
# El secreto con el que la herramienta donde los alumnos completan su reporte (un formulario, una
# automatización del Airtable) le manda cada respuesta a POST /api/reportes/webhook, en
# «Authorization: Bearer …». Sin él esa ruta contesta 503. Inventalo largo (openssl rand -hex 32), ponelo
# en Vercel (Producción, como secreto) y en la herramienta que manda los reportes. Nunca lo escribas en el
# repo. Necesita SUPABASE_SERVICE_ROLE_KEY (arriba). Cómo se arma el pedido: README, «Reportes semanales».
REPORTES_WEBHOOK_TOKEN=
